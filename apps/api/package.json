{
  "name": "@arcane-table/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "clean": "rimraf dist coverage",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@arcane-table/config": "workspace:*",
    "@arcane-table/converter-core": "workspace:*",
    "@arcane-table/persistence": "workspace:*",
    "@arcane-table/protocol": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
